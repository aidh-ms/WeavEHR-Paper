# Copy this file to .env, fill in your own paths, then `source .env`
# before running any script directly or before `sbatch`-ing a job.
# No real paths belong in this file -- it's committed as a template.
#
# Everything here is machine-specific (raw credentialed data, local tool
# installs). Paths that are not machine-specific (this experiment's own
# generated output/results) are not listed here -- they live under this
# experiment's own directory and need no configuration.

# Raw eICU-CRD download (PhysioNet), used as the extraction step's dataset
# source and directly for fields the WeavEHR pipeline doesn't carry
# (e.g. ricu's own stay filtering reads the raw tables itself).
export EICU_CRD_RAW_PATH=/path/to/physionet.org/files/eicu-crd/2.0

# Directory containing per-file symlinks into the raw eICU-CRD download,
# named to match ricu's own expected source-directory convention
# (<RICU_DATA_PATH>/eicu/*.csv.gz) -- kept separate from the actual
# credentialed PhysioNet directory so ricu's own cache never writes there.
export RICU_DATA_PATH=/path/to/ricu_data

# Local clone of georginapetr/openicu-yaib -- needed as an actual checkout,
# not just the installed package (a pyproject dependency of this repo), for
# resource files (e.g. scripts/datasets/export_ricu_eicu-crd.R) the
# comparison script runs directly.
export OPENICU_YAIB_REPO_ROOT=/path/to/openicu-yaib

# conda's own binary and the R environment name ricu/arrow/data.table are
# installed into.
export CONDA_BIN=/path/to/miniconda/bin/conda
# Optional, defaults to "yaib-cohorts2" if unset:
# export RICU_CONDA_ENV=yaib-cohorts2
