# Copy this file to .env, fill in your own paths, then `source .env`
# before running any script directly or before `sbatch`-ing a job.
# No real paths belong in this file -- it's committed as a template.

# Raw eICU-CRD download (PhysioNet), used as the extraction step's dataset
# source and directly for fields WeavEHR's own pipeline can't provide
# (sex, death_icu, hospital_id -- see each script's own docstring for why).
export EICU_CRD_RAW_PATH=/path/to/physionet.org/files/eicu-crd/2.0

# Local clone of the official YAIB training codebase (rvandewater/YAIB),
# with its own venv at <YAIB_REPO_ROOT>/.venv (a separate tool, not managed
# by this repo's own uv environment).
export YAIB_REPO_ROOT=/path/to/YAIB-clean
