# Benchmark settings, sourced by common/bench.sh.

# PhysioNet download folder (inputs, mounted read-only). Expected inside:
#   mimiciv/3.1, eicu-crd/2.0                  (DEMO=0)
#   mimic-iv-demo/2.2, eicu-crd-demo/2.0.1     (DEMO=1)
# Keep it on local NVMe; OUT_DIR should be a different directory.
DATA_DIR=$HOME/data/physionet.org/files
OUT_DIR=$HOME/scalability-results

# 1 = use the demo datasets, e.g. with REPEATS=1 and MEM_LIMITS=16 for a quick test.
DEMO=0

# Each dataset is processed in its own container run.
DATASETS="mimic-iv eicu"

# Container memory limits in GB, CPU limits in cores (pinned to cores
# 0..N-1) and repetitions per memory/CPU combination.
MEM_LIMITS="16 32 48"
CPU_LIMITS="8"
REPEATS=5
